
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Local app data (Portable Scope — never commit)
app.key
catalog.sqlite
catalog.sqlite-shm
catalog.sqlite-wal

# App data (Freebuff desktop database)
.freebuff

# graphify generated outputs (graphify-out/ itself is committed per official
# recommendation; exclude only local cost tracking + cache)
graphify-out/cost.json
graphify-out/cache/

# ── Go (Wails backend) ──────────────────────────────────────────
# Compiled binaries & build output
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
bin/
build/bin/
# Standalone build artifact produced by `wails build`
mariadb-restore-desktop-app

# ── React / TypeScript (Wails frontend) ─────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
coverage/
# Generated Wails bindings + frontend build
src/frontend/dist/
src/frontend/wailsjs/
frontend/dist/
frontend/wailsjs/
# TypeScript incremental build cache
*.tsbuildinfo
# Vite TS-emit leftovers (vite v7 emits .d.ts and .js alongside vite.config.ts)
src/frontend/vite.config.js
src/frontend/vite.config.d.ts
# Local env / logs
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

*/skills/